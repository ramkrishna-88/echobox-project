# Required: use a private random value of at least 32 bytes.
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes

# Required: used when the admin account is first created.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# The browser reaches the API through the frontend's Nginx proxy.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
